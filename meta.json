{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "viam:cocktail-bot",
  "visibility": "public",
  "url": "https://github.com/viam-labs/cocktail-bot",
  "description": "Cocktail-making robot orchestration",
  "models": [
    {
      "api": "rdk:service:generic",
      "model": "viam:cocktail-bot:bartender",
      "short_description": "Orchestrates a cocktail-making robot through pour, mix, and serve."
    },
    {
      "api": "rdk:component:sensor",
      "model": "viam:cocktail-bot:order-sensor",
      "short_description": "Queues one reading per order attempt for capture by Data Management."
    },
    {
      "api": "rdk:service:vision",
      "model": "viam:cocktail-bot:glass-finder",
      "short_description": "Locates glasses in 3D by lifting 2D detector boxes into the camera point cloud."
    },
    {
      "api": "rdk:component:switch",
      "model": "viam:cocktail-bot:pose-switcher",
      "short_description": "Named arm poses; stores absolute values or baseline-relative deltas."
    }
  ],
  "entrypoint": "bin/cocktail-bot",
  "build": {
    "build": "make module.tar.gz",
    "setup": "make setup",
    "path": "module.tar.gz",
    "arch": [
      "linux/amd64",
      "linux/arm64"
    ]
  }
}